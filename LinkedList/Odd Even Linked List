class Solution {
    public ListNode oddEvenList(ListNode head) {
        ListNode tl = new ListNode(-1);
        ListNode tg = new ListNode(-1);
        ListNode temp = head;
        ListNode dl = tl;
        ListNode dg = tg;
        int i =1;
        while(temp != null){
            if(i%2 != 0){
                tl.next = temp;
                tl = tl.next;
            }else{
                tg.next = temp;
                tg = tg.next;
            }
            temp = temp.next;
            i++;
        }
      tl.next = dg.next;
      tg.next = null;
      return dl.next;
    }  
    }
