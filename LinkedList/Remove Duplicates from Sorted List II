class Solution {
    public ListNode deleteDuplicates(ListNode head) {

        ListNode l1 = new ListNode(0);
        l1.next = head;

        ListNode prev = l1;
        ListNode curr = head;

        while (curr != null) {
            if (curr.next != null && curr.val == curr.next.val) {
                int duplicate = curr.val;
                while (curr != null && curr.val == duplicate) {
                    curr = curr.next;
                }
                prev.next = curr;

            } else {
                prev = curr;
                curr = curr.next;
            }
        }

        return l1.next;
    }
}
