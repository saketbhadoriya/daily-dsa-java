class Solution {
    public int returnpos(int[] nums, int target, boolean use) {
        int st = 0;
        int end = nums.length - 1;
        int a = -1;

        while (st <= end) {
            int mid = st + (end - st) / 2;
            if (nums[mid] == target) {
                a = mid;
                if (use == false) {
                    end = mid - 1;
                } else {
                    st = mid + 1;
                }
            } else if (nums[mid] < target) {
                st = mid + 1;
            } else {
                end = mid - 1;
            }
        }

        return a;
    }
    public int[] searchRange(int[] nums, int target) {
        int[] arr = new int[2];
        arr[0] = returnpos(nums, target, false);
        arr[1] = returnpos(nums, target, true);

        return arr;
    }
}
