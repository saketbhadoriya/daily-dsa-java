class Solution {
    public int findPeakElement(int[] nums) {
          if(nums.length == 1){
            return 0;
        }
        int st=0, end = nums.length-1;
        while(st <= end){
           int mid = st + (end-st)/2;
           if(nums[st] > nums[st+1] ){
               return st;
           }else if(nums[end] > nums[end-1]){
               return end;
           }else{
               
           
           if(nums[mid] > nums[mid-1] && nums[mid] > nums[mid+1]){
               return mid;
           }
          else if(nums[mid] > nums[mid+1] && nums[mid] < nums[mid-1]){
           end = mid;    
           }else{
               st = mid+1;
           }
        } 
        }
        return st;  
    }
}
