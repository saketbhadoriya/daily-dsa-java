class Solution {
       public boolean Isprime(int num) {
        if (num < 2) {
            return false;
        }
        for (int i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                return false;
            }
        }
        return true;
    }
    public int minNumber(int[] arr) {
        int sum = 0;
        for(int i=0;i<arr.length;i++){
            sum += arr[i];
        }
        
        int ans = 0;
        while(!Isprime(sum+ans)){
            ans++;
        }
        return ans;
        
    }
}
